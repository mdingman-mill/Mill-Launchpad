{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile and app preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "name": { "type": "string", "description": "Display name" },
        "avatar": { "type": "string", "description": "Avatar URL" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "support", "member"], "description": "System role" },
        "organizationId": { "type": "string", "description": "Associated organization ID" },
        "orgRole": { "type": "string", "enum": ["owner", "member"], "description": "Role within the organization" },
        "planId": { "type": "string", "enum": ["free", "pro", "team", "complimentary"], "description": "Subscription plan tier" },
        "generationsUsedThisMonth": { "type": "number", "description": "Per-member AI generation count used in billing cycle" },
        "totalGenerations": { "type": "number", "description": "Cumulative total AI tool generations across all billing cycles" },
        "billingResetDate": { "type": "string", "description": "ISO date for next monthly reset" },
        "createdAt": { "type": "string", "description": "Timestamp when account was created" },
        "updatedAt": { "type": "string", "description": "Timestamp when account was last updated" }
      },
      "required": ["id", "email", "name", "role", "planId", "generationsUsedThisMonth", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Super administrator lookup document for security rules",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "UID of the super administrator" },
        "email": { "type": "string", "format": "email", "description": "Super admin email address" },
        "role": { "type": "string", "enum": ["super_admin"], "description": "Role marker" },
        "createdAt": { "type": "string", "description": "Timestamp registered as admin" }
      },
      "required": ["id", "email", "role", "createdAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Organization and brand profile containing marketing foundations, pooled quota, and team seats",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Organization unique identifier" },
        "name": { "type": "string", "description": "Organization display name" },
        "ownerId": { "type": "string", "description": "User ID of organization owner" },
        "memberIds": { "type": "array", "description": "List of user IDs who are members" },
        "type": { "type": "string", "enum": ["Nonprofit", "Startup"], "description": "Entity category" },
        "whatTheyDo": { "type": "string", "description": "Summary of products, mission or services" },
        "targetAudience": { "type": "string", "description": "Core personas and customer segments" },
        "goals": { "type": "array", "description": "Top 3 priorities for the next 6 months" },
        "brandTone": { "type": "array", "description": "Selected brand voice traits" },
        "budget": { "type": "string", "description": "Estimated monthly marketing budget" },
        "website": { "type": "string", "description": "Official website URL" },
        "planId": { "type": "string", "enum": ["free", "pro", "team", "complimentary"], "description": "Current plan tier" },
        "seatLimit": { "type": "number", "description": "Maximum allowed seats for the organization" },
        "generationsUsedThisMonth": { "type": "number", "description": "Pooled monthly AI generations used by organization" },
        "bonusGenerations": { "type": "number", "description": "Pooled bonus monthly generations for organization" },
        "billingResetDate": { "type": "string", "description": "ISO date for next monthly pooled reset" },
        "createdAt": { "type": "string", "description": "Created timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["id", "name", "ownerId", "memberIds", "planId", "seatLimit", "createdAt"]
    },
    "OutputItem": {
      "title": "OutputItem",
      "description": "Saved AI-generated marketing deliverable saved in shared organization library",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique deliverable ID" },
        "orgId": { "type": "string", "description": "Owning organization ID" },
        "userId": { "type": "string", "description": "Author user ID" },
        "userName": { "type": "string", "description": "Author display name" },
        "toolId": { "type": "string", "description": "ID of marketing tool used" },
        "toolName": { "type": "string", "description": "Human readable tool name" },
        "title": { "type": "string", "description": "Deliverable title" },
        "content": { "type": "string", "description": "Full markdown output content" },
        "tags": { "type": "array", "description": "Categorization and search tags" },
        "userInputs": { "type": "object", "description": "Input parameters provided to tool" },
        "copiedFromId": { "type": "string", "description": "Original output ID when saved as a copy" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" },
        "updatedBy": { "type": "string", "description": "UID of user who last edited the item" },
        "updatedByName": { "type": "string", "description": "Name of user who last edited the item" }
      },
      "required": ["id", "orgId", "userId", "toolId", "toolName", "title", "content", "createdAt"]
    },
    "GenerationHistoryItem": {
      "title": "GenerationHistoryItem",
      "description": "Server-recorded AI tool generation history record with 12-month retention",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique history record ID" },
        "orgId": { "type": "string", "description": "Owning organization ID" },
        "userId": { "type": "string", "description": "User ID who ran the generation" },
        "userName": { "type": "string", "description": "User display name at generation time" },
        "toolId": { "type": "string", "description": "Marketing tool ID" },
        "toolName": { "type": "string", "description": "Marketing tool human-readable name" },
        "inputs": { "type": "object", "description": "Form inputs submitted for the generation" },
        "output": { "type": "string", "description": "Generated markdown deliverable text" },
        "model": { "type": "string", "description": "AI model identifier used" },
        "durationMs": { "type": "number", "description": "Total generation duration in milliseconds" },
        "createdAt": { "type": "string", "description": "ISO timestamp when generation completed" }
      },
      "required": ["id", "orgId", "userId", "userName", "toolId", "toolName", "inputs", "output", "model", "durationMs", "createdAt"]
    },
    "Invite": {
      "title": "Invite",
      "description": "Team member or complimentary access invitation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Invite ID" },
        "orgId": { "type": "string", "description": "Inviting organization ID" },
        "email": { "type": "string", "format": "email", "description": "Invited user email" },
        "role": { "type": "string", "description": "Assigned role" },
        "invitedBy": { "type": "string", "description": "User ID of inviter" },
        "status": { "type": "string", "enum": ["pending", "accepted", "revoked", "expired", "declined"], "description": "Invite status" },
        "expiresAt": { "type": "string", "description": "Optional expiration timestamp" },
        "createdAt": { "type": "string", "description": "Invite creation timestamp" }
      },
      "required": ["id", "email", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit trail recording system actions and generations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log entry unique ID" },
        "userId": { "type": "string", "description": "User UID who triggered action" },
        "userEmail": { "type": "string", "description": "User email address" },
        "orgId": { "type": "string", "description": "Organization ID" },
        "action": { "type": "string", "description": "Action name e.g. TOOL_GENERATION" },
        "details": { "type": "string", "description": "Detailed description of action" },
        "createdAt": { "type": "string", "description": "Timestamp of action" }
      },
      "required": ["id", "userId", "action", "createdAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global platform configuration including Invite-Only Mode",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Setting document identifier" },
        "inviteOnlyMode": { "type": "boolean", "description": "Disables self-account creation and paid plans when true" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" },
        "updatedBy": { "type": "string", "description": "UID of super admin who updated settings" },
        "updatedByEmail": { "type": "string", "format": "email", "description": "Email of super admin who updated settings" }
      },
      "required": ["id", "inviteOnlyMode", "updatedAt"]
    },
    "PlanSettings": {
      "title": "PlanSettings",
      "description": "Dynamic plan pricing and monthly generation limit overrides stored at settings/plans",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document identifier (plans)" },
        "plans": { "type": "object", "description": "Map of planId (free, pro, team, complimentary) to price, priceNonprofit, and generationLimit" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" },
        "updatedBy": { "type": "string", "description": "UID of super admin who updated plans" },
        "updatedByEmail": { "type": "string", "format": "email", "description": "Email of super admin who updated plans" }
      },
      "required": ["id", "plans", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts and profile state"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Super admin registry for security rules verification"
    },
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Organizations, pooled quota, seat limits, and saved brand foundations"
    },
    "/organizations/{orgId}/outputs/{outputId}": {
      "schema": "OutputItem",
      "description": "Deliverables saved to organization library"
    },
    "/organizations/{orgId}/history/{historyId}": {
      "schema": "GenerationHistoryItem",
      "description": "Server-written AI tool generation history records (12-month retention)"
    },
    "/organizations/{orgId}/invites/{inviteId}": {
      "schema": "Invite",
      "description": "Pending and accepted team invitations"
    },
    "/teamInvites/{inviteId}": {
      "schema": "Invite",
      "description": "Server-managed team invite index"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "System activity and generation audit log"
    },
    "/invites/{inviteId}": {
      "schema": "Invite",
      "description": "Top-level complimentary access invites"
    },
    "/settings/{settingId}": {
      "schema": "PlatformSettings",
      "description": "Global platform settings managed by super admins"
    }
  }
}
