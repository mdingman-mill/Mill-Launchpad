rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
          (
            'memberIds' in get(/databases/$(database)/documents/organizations/$(orgId)).data &&
            request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.memberIds
          )
        )
      );
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.planId == 'free' &&
        request.resource.data.role == 'member' &&
        request.resource.data.generationsUsedThisMonth == 0;
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'organizationProfile', 'lastLogin'])
      );
      allow delete: if isAdmin();
    }

    // Super Admins Registry
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Organizations & Brand Foundations
    match /organizations/{orgId} {
      allow get: if isAdmin() || (isSignedIn() && (resource.data.ownerId == request.auth.uid || ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds)));
      allow list: if isAdmin() || (isSignedIn() && (resource.data.ownerId == request.auth.uid || ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds)));
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (isSignedIn() && (resource.data.ownerId == request.auth.uid || ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds)));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      // Outputs subcollection
      match /outputs/{outputId} {
        allow read: if isAdmin() || isOrgMember(orgId);
        allow create: if (isAdmin() || isOrgMember(orgId)) && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin() || (isOrgMember(orgId) && resource.data.userId == request.auth.uid);
        allow delete: if isAdmin() || (isOrgMember(orgId) && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid));
      }

      // Invites subcollection
      match /invites/{inviteId} {
        allow read: if isAdmin() || isOrgMember(orgId) || (isSignedIn() && request.auth.token.email != null && resource.data.email == request.auth.token.email);
        allow create: if isAdmin() || isOrgMember(orgId);
        allow update: if isAdmin() || isOrgMember(orgId) || (isSignedIn() && request.auth.token.email != null && resource.data.email == request.auth.token.email);
        allow delete: if isAdmin() || isOrgMember(orgId);
      }
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Top-Level Invites Collection (Complimentary Access System)
    match /invites/{inviteId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.email != null &&
        resource.data.email == request.auth.token.email
      );
      allow write: if isAdmin();
    }
  }
}
