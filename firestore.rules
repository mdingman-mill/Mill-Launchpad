rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasVerifiedEmailMatch(targetEmail) {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email != null &&
        targetEmail is string &&
        targetEmail.lower() == request.auth.token.email.lower();
    }

    function isOrgOwner(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
          (
            'memberIds' in get(/databases/$(database)/documents/organizations/$(orgId)).data &&
            request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.memberIds
          )
        )
      );
    }

    function isInviteOnlyMode() {
      return exists(/databases/$(database)/documents/settings/platform) &&
        get(/databases/$(database)/documents/settings/platform).data.inviteOnlyMode == true;
    }

    // Users Collection
    // organizationId and orgRole can only be changed by the server (Admin SDK) or a super admin.
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && (
        isAdmin() || (
          !isInviteOnlyMode() &&
          isOwner(userId) &&
          request.resource.data.id == userId &&
          request.resource.data.planId == 'free' &&
          request.resource.data.role == 'member' &&
          request.resource.data.generationsUsedThisMonth == 0 &&
          request.resource.data.get('totalGenerations', 0) == 0 &&
          request.resource.data.get('bonusGenerations', 0) == 0 &&
          request.resource.data.get('nonprofitDiscountApproved', false) == false &&
          request.resource.data.get('status', 'active') == 'active' &&
          request.resource.data.get('orgRole', 'owner') == 'owner' &&
          (!('organizationId' in request.resource.data) || request.resource.data.organizationId == ('org_' + userId)) &&
          (!('organizationIds' in request.resource.data) || (
            request.resource.data.organizationIds is list &&
            request.resource.data.organizationIds.size() == 1 &&
            request.resource.data.organizationIds[0] == ('org_' + userId)
          ))
        )
      );
      allow update: if isValidId(userId) && (
        isAdmin() || (
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'organizationProfile', 'lastLogin']) &&
          (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 150)) &&
          (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 1000)) &&
          (!('lastLogin' in request.resource.data) || (request.resource.data.lastLogin is string && request.resource.data.lastLogin.size() <= 64)) &&
          (!('organizationProfile' in request.resource.data) || request.resource.data.organizationProfile is map)
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Super Admins Registry (Managed by Server Admin SDK only)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // Organizations & Brand Foundations
    // Members can read their own org. ownerId, memberIds, planId, seatLimit, and usage fields
    // can only be changed by the server (Admin SDK) or a super admin.
    match /organizations/{orgId} {
      allow get: if isValidId(orgId) && (
        (isSignedIn() && (resource.data.ownerId == request.auth.uid || ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds))) ||
        isAdmin()
      );
      allow list: if (isSignedIn() && (resource.data.ownerId == request.auth.uid || ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds))) || isAdmin();
      allow create: if isValidId(orgId) && (
        isAdmin() || (
          !isInviteOnlyMode() &&
          isSignedIn() &&
          orgId == ('org_' + request.auth.uid) &&
          request.resource.data.id == orgId &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.get('planId', 'free') == 'free' &&
          request.resource.data.get('seatLimit', 1) == 1 &&
          request.resource.data.get('generationsUsedThisMonth', 0) == 0 &&
          request.resource.data.get('bonusGenerations', 0) == 0 &&
          request.resource.data.memberIds is list &&
          request.resource.data.memberIds.size() == 1 &&
          request.auth.uid in request.resource.data.memberIds &&
          (!('memberRoles' in request.resource.data) || (
            request.resource.data.memberRoles is map &&
            request.resource.data.memberRoles.keys().hasOnly([request.auth.uid]) &&
            request.resource.data.memberRoles[request.auth.uid] == 'owner'
          ))
        )
      );
      allow update: if isValidId(orgId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'type',
            'whatTheyDo',
            'targetAudience',
            'goals',
            'brandTone',
            'budget',
            'website',
            'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(orgId) && isAdmin();

      // Outputs subcollection (shared across all members of the organization)
      match /outputs/{outputId} {
        allow get: if isValidId(orgId) && isValidId(outputId) && (isOrgMember(orgId) || isAdmin());
        allow list: if isValidId(orgId) && (isOrgMember(orgId) || isAdmin());
        allow create: if isValidId(orgId) &&
          isValidId(outputId) &&
          (isOrgMember(orgId) || isAdmin()) &&
          request.resource.data.id == outputId &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 300 &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 200000 &&
          (!('orgId' in request.resource.data) || request.resource.data.orgId == orgId) &&
          (!('userName' in request.resource.data) || (request.resource.data.userName is string && request.resource.data.userName.size() <= 150));
        allow update: if isValidId(orgId) &&
          isValidId(outputId) &&
          (
            isAdmin() ||
            (
              isOrgMember(orgId) &&
              (resource.data.userId == request.auth.uid || isOrgOwner(orgId)) &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'userId', 'userName', 'orgId', 'createdAt', 'copiedFromId']) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'tags', 'userInputs', 'updatedAt', 'updatedBy', 'updatedByName']) &&
              (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 300)) &&
              (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 200000))
            )
          );
        allow delete: if isValidId(orgId) &&
          isValidId(outputId) &&
          (isAdmin() || (isOrgMember(orgId) && (resource.data.userId == request.auth.uid || isOrgOwner(orgId))));
      }

      // Generation History subcollection (server Admin SDK creates only; members read; creator/owner can delete)
      match /history/{historyId} {
        allow get: if isValidId(orgId) && isValidId(historyId) && (isOrgMember(orgId) || isAdmin());
        allow list: if isValidId(orgId) && (isOrgMember(orgId) || isAdmin());
        allow create, update: if false;
        allow delete: if isValidId(orgId) &&
          isValidId(historyId) &&
          (isAdmin() || (isOrgMember(orgId) && (resource.data.userId == request.auth.uid || isOrgOwner(orgId))));
      }

      // Team Invites subcollection (managed strictly via Server Admin SDK endpoints)
      match /invites/{inviteId} {
        allow get: if isValidId(orgId) && isValidId(inviteId) && (isAdmin() || isOrgMember(orgId) || hasVerifiedEmailMatch(resource.data.email));
        allow list: if isValidId(orgId) && (isAdmin() || isOrgOwner(orgId) || hasVerifiedEmailMatch(resource.data.email));
        allow write: if false;
      }
    }

    // Server-side Team Invite Lookup Index (Admin SDK only)
    match /teamInvites/{inviteId} {
      allow read, write: if false;
    }

    // Audit logs (append-only; privileged actions restricted to Admin SDK)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && ((isSignedIn() && resource.data.actorId == request.auth.uid) || isAdmin());
      allow list: if (isSignedIn() && resource.data.actorId == request.auth.uid) || isAdmin();
      allow create: if isValidId(logId) &&
        isSignedIn() &&
        request.resource.data.id == logId &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.action is string &&
        request.resource.data.action.size() <= 80 &&
        request.resource.data.details is string &&
        request.resource.data.details.size() <= 1000 &&
        !(request.resource.data.action in [
          'INVITE_CREATED',
          'INVITE_ACCEPTED',
          'INVITE_REVOKED',
          'TEAM_CREATED',
          'TEAM_DELETED',
          'TEAM_RENAMED',
          'TEAM_SWITCHED',
          'TEAM_INVITE_CREATED',
          'TEAM_INVITE_ACCEPTED',
          'TEAM_INVITE_DECLINED',
          'TEAM_INVITE_REVOKED',
          'TEAM_MEMBER_ADDED',
          'TEAM_MEMBER_REMOVED',
          'TEAM_MEMBER_LEFT',
          'OWNERSHIP_TRANSFERRED',
          'SEAT_LIMIT_CHANGED',
          'PLAN_CHANGED',
          'PLAN_UPGRADED',
          'SUBSCRIPTION_CHANGED',
          'SUBSCRIPTION_CANCELED',
          'ROLE_CHANGED',
          'ADMIN_INVITE',
          'ADMIN_PLAN_UPDATE',
          'ADMIN_ROLE_UPDATE',
          'BONUS_GENERATIONS_GRANTED',
          'USAGE_RESET',
          'DISCOUNT_TOGGLED',
          'USER_STATUS_CHANGE',
          'USER_DELETED',
          'SETTINGS_UPDATED',
          'PLANS_UPDATED'
        ]);
      allow update, delete: if false;
    }

    // Top-Level Invites Collection (Complimentary Access System)
    match /invites/{inviteId} {
      allow get: if isValidId(inviteId) && (hasVerifiedEmailMatch(resource.data.email) || isAdmin());
      allow list: if hasVerifiedEmailMatch(resource.data.email) || isAdmin();
      allow write: if isAdmin();
    }

    // Global Platform Settings (Managed strictly via Server Admin SDK)
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}
