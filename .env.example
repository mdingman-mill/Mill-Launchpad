# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# For Netlify production deployment, set this to your Netlify URL.
APP_URL="https://millennium-launchpad.netlify.app"

# SUPER_ADMIN_EMAILS: Comma-separated list of super admin emails.
# Server checks this upon user sign-in to assign super_admin role.
SUPER_ADMIN_EMAILS="mdingman@mill.agency,lfanaras@mill.agency,bbreines@mill.agency"

# FIREBASE_SERVICE_ACCOUNT_KEY (Required for Netlify Functions / non-GCP hosts):
# Full JSON (or base64-encoded JSON) of a Firebase Service Account key from
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key.
# Alternatively, provide FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY separately.
FIREBASE_SERVICE_ACCOUNT_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
